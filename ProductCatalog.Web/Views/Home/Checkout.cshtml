@model ProductCatalog.Model.model.Cart.Cart
@{
    ViewData["Title"] = "Оплата";
}

<style>
    .checkout-wrap {
        max-width: 900px;
        margin: 0 auto;
        padding: 24px 16px;
    }

    .checkout-title {
        font-size: 26px;
        font-weight: 700;
        color: #2e3642;
        margin-bottom: 20px;
    }

    .checkout-layout {
        display: grid;
        grid-template-columns: 1fr 320px;
        gap: 20px;
        align-items: start;
    }

    .card-form {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.06);
        padding: 28px;
    }

        .card-form h5 {
            font-weight: 700;
            font-size: 16px;
            margin-bottom: 20px;
            color: #2e3642;
        }

        .card-form label {
            font-size: 13px;
            font-weight: 600;
            color: #4f5b6b;
            margin-bottom: 6px;
            display: block;
        }

        .card-form .form-control {
            border: 1.5px solid #e9edf5;
            border-radius: 12px;
            padding: 11px 14px;
            font-size: 15px;
            background: #f9fafc;
            transition: border 0.2s;
        }

            .card-form .form-control:focus {
                border-color: #6b4dff;
                background: #fff;
                box-shadow: 0 0 0 3px rgba(107,77,255,0.08);
                outline: none;
            }

    .card-preview {
        background: linear-gradient(135deg, #2097ff, #6b4dff);
        border-radius: 16px;
        padding: 24px;
        color: #fff;
        margin-bottom: 24px;
        position: relative;
        min-height: 130px;
    }

        .card-preview .card-number {
            font-size: 20px;
            font-weight: 600;
            letter-spacing: 3px;
            margin-top: 20px;
        }

        .card-preview .card-meta {
            display: flex;
            justify-content: space-between;
            margin-top: 16px;
            font-size: 13px;
            opacity: 0.85;
        }

    .card-chip {
        width: 36px;
        height: 26px;
        background: rgba(255,255,255,0.3);
        border-radius: 6px;
    }

    .two-col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
    }

    .btn-pay {
        width: 100%;
        border: none;
        border-radius: 999px;
        padding: 14px;
        font-size: 16px;
        font-weight: 600;
        color: #fff;
        background: linear-gradient(90deg, #2097ff, #6b4dff);
        box-shadow: 0 8px 18px rgba(74,88,255,0.28);
        cursor: pointer;
        transition: opacity 0.2s;
        margin-top: 8px;
    }

        .btn-pay:hover {
            opacity: 0.9;
        }

    .summary-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.06);
        padding: 24px;
    }

        .summary-card h5 {
            font-weight: 700;
            font-size: 16px;
            margin-bottom: 16px;
            color: #2e3642;
        }

    .order-item {
        display: flex;
        justify-content: space-between;
        margin-bottom: 10px;
        font-size: 14px;
    }

    .order-item-name {
        color: #4f5b6b;
    }

    .order-item-price {
        font-weight: 600;
        color: #2e3642;
        white-space: nowrap;
    }

    .divider {
        height: 1px;
        background: #f0f2f7;
        margin: 14px 0;
    }

    .total-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .total-label {
        font-size: 15px;
        font-weight: 600;
        color: #2e3642;
    }

    .total-value {
        font-size: 24px;
        font-weight: 700;
        color: #2e3642;
    }

    .secure-hint {
        text-align: center;
        font-size: 12px;
        color: #8b95a8;
        margin-top: 12px;
    }

    @@media (max-width: 768px) {
        .checkout-layout {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="checkout-wrap">
    <div class="checkout-title">💳 Оплата заказа</div>

    <div class="checkout-layout">
        <div class="card-form">
            <div class="card-preview">
                <div class="card-chip"></div>
                <div class="card-number" id="previewNumber">•••• •••• •••• ••••</div>
                <div class="card-meta">
                    <span id="previewName">ИМЯ ВЛАДЕЛЬЦА</span>
                    <span id="previewExpiry">MM/YY</span>
                </div>
            </div>

            <h5>Данные карты</h5>

            <form asp-action="PlaceOrder" method="post">
                <div class="mb-3">
                    <label>Номер карты</label>
                    <input name="cardNumber" class="form-control" placeholder="0000 0000 0000 0000"
                           maxlength="19" id="cardNumber" required />
                </div>

                <div class="mb-3">
                    <label>Имя владельца</label>
                    <input name="cardHolder" class="form-control" placeholder="IVAN IVANOV"
                           id="cardHolder" style="text-transform:uppercase" required />
                </div>

                <div class="two-col mb-4">
                    <div>
                        <label>Срок действия</label>
                        <input name="cardExpiry" class="form-control" placeholder="MM/YY"
                               maxlength="5" id="cardExpiry" required />
                    </div>
                    <div>
                        <label>CVV</label>
                        <input name="cardCvv" class="form-control" placeholder="•••"
                               maxlength="3" type="password" required />
                    </div>
                </div>

                <button type="submit" class="btn-pay">
                    Оплатить @Model.TotalPrice.ToString("N0") ₽
                </button>
            </form>

            <div class="secure-hint">🔒 Защищённое соединение · Данные не сохраняются</div>
        </div>

        <div class="summary-card">
            <h5>Ваш заказ</h5>

            @foreach (var item in Model.Items)
            {
                <div class="order-item">
                    <span class="order-item-name">@item.Game.Name × @item.Quantity</span>
                    <span class="order-item-price">@((item.Game.Price * item.Quantity).ToString("N0")) ₽</span>
                </div>
            }

            <div class="divider"></div>

            <div class="total-row">
                <span class="total-label">Итого</span>
                <span class="total-value">@Model.TotalPrice.ToString("N0") ₽</span>
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById('cardNumber').addEventListener('input', function () {
        let v = this.value.replace(/\D/g, '').substring(0, 16);
        this.value = v.replace(/(.{4})/g, '$1 ').trim();
        document.getElementById('previewNumber').textContent =
            (this.value || '•••• •••• •••• ••••').padEnd(19, '•');
    });

    document.getElementById('cardHolder').addEventListener('input', function () {
        document.getElementById('previewName').textContent =
            this.value.toUpperCase() || 'ИМЯ ВЛАДЕЛЬЦА';
    });

    document.getElementById('cardExpiry').addEventListener('input', function () {
        let v = this.value.replace(/\D/g, '').substring(0, 4);
        if (v.length >= 2) v = v.substring(0, 2) + '/' + v.substring(2);
        this.value = v;
        document.getElementById('previewExpiry').textContent = this.value || 'MM/YY';
    });
</script>