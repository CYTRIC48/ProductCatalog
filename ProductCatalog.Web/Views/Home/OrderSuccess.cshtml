@model ProductCatalog.Model.model.Order.Order
@{
    ViewData["Title"] = "Заказ оформлен";
}

<style>
    body {
        background-color: #f5f5f5;
        font-family: 'Segoe UI', sans-serif;
    }

    .success-wrap {
        max-width: 600px;
        margin: 60px auto;
        padding: 0 16px;
        text-align: center;
    }

    .success-icon {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: linear-gradient(135deg, #2097ff, #6b4dff);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 36px;
        margin: 0 auto 20px;
        box-shadow: 0 8px 24px rgba(74,88,255,0.3);
    }

    .success-title {
        font-size: 26px;
        font-weight: 700;
        color: #2e3642;
        margin-bottom: 8px;
    }

    .success-sub {
        font-size: 15px;
        color: #8b95a8;
        margin-bottom: 28px;
    }

    .order-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.06);
        padding: 24px;
        text-align: left;
        margin-bottom: 20px;
    }

        .order-card h5 {
            font-weight: 700;
            font-size: 15px;
            color: #2e3642;
            margin-bottom: 14px;
        }

    .order-row {
        display: flex;
        justify-content: space-between;
        font-size: 14px;
        margin-bottom: 8px;
    }

    .order-row-label {
        color: #8b95a8;
    }

    .order-row-value {
        font-weight: 600;
        color: #2e3642;
    }

    .divider {
        height: 1px;
        background: #f0f2f7;
        margin: 14px 0;
    }

    .status-badge {
        display: inline-block;
        padding: 4px 14px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 600;
        background: #e8f5e9;
        color: #2e7d32;
    }

    .item-row {
        display: flex;
        justify-content: space-between;
        font-size: 14px;
        margin-bottom: 8px;
    }

    .item-name {
        color: #4f5b6b;
    }

    .item-price {
        font-weight: 600;
        color: #2e3642;
    }

    .btn-home {
        display: inline-block;
        border: none;
        border-radius: 999px;
        padding: 13px 32px;
        font-size: 15px;
        font-weight: 600;
        color: #fff;
        background: linear-gradient(90deg, #2097ff, #6b4dff);
        box-shadow: 0 8px 18px rgba(74,88,255,0.28);
        text-decoration: none;
        transition: opacity 0.2s;
    }

        .btn-home:hover {
            opacity: 0.9;
            color: #fff;
        }
</style>

<div class="success-wrap">
    <div class="success-icon">✓</div>
    <div class="success-title">Заказ успешно оформлен!</div>
    <div class="success-sub">Спасибо за покупку. Ваш заказ №@Model.Id принят.</div>

    <div class="order-card">
        <h5>Детали заказа</h5>

        <div class="order-row">
            <span class="order-row-label">Номер заказа</span>
            <span class="order-row-value">#@Model.Id</span>
        </div>
        <div class="order-row">
            <span class="order-row-label">Дата</span>
            <span class="order-row-value">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
        </div>
        <div class="order-row">
            <span class="order-row-label">Статус</span>
            <span class="status-badge">✓ Оплачен</span>
        </div>

        <div class="divider"></div>

        <h5>Состав заказа</h5>
        @foreach (var item in Model.Items)
        {
            <div class="item-row">
                <span class="item-name">@item.ProductName × @item.Quantity</span>
                <span class="item-price">@((item.Price * item.Quantity).ToString("N0")) ₽</span>
            </div>
        }

        <div class="divider"></div>

        <div class="order-row">
            <span class="order-row-label" style="font-weight:700;font-size:15px">Итого</span>
            <span class="order-row-value" style="font-size:20px">@Model.TotalAmount.ToString("N0") ₽</span>
        </div>
    </div>

    <a asp-controller="Home" asp-action="Index" class="btn-home">
        Продолжить покупки
    </a>
</div>