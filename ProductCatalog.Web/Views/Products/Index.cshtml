@model IEnumerable<ProductCatalog.Model.model.Product.Product>
@{
    ViewData["Title"] = "Список товаров";
    var currentSort = ViewData["CurrentSort"] as string;
    var nameSort = ViewData["NameSort"] as string;
    var priceSort = ViewData["PriceSort"] as string;
    var quantitySort = ViewData["QuantitySort"] as string;
    var searchStringP = ViewData["SearchString"] as string;
}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-box-seam"></i> Список товаров</h2>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Добавить товар
        </a>
    </div>

    <form method="get" class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" name="searchString" value="@searchStringP"
                       class="form-control" placeholder="Поиск по названию..." />
            </div>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Найти</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Сбросить</a>
        </div>
    </form>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>
                            <a asp-action="Index" asp-route-sortOrder="@nameSort" asp-route-searchString="@searchStringP"
                               class="text-white text-decoration-none">
                                Название
                                @if (currentSort == "name_asc")
                                {
                                    <i class="bi bi-arrow-up"></i>
                                }
                                else if (currentSort == "name_desc")
                                {

                                    <i class="bi bi-arrow-down"></i>
                                }
                            </a>
                        </th>
                        <th>Категория</th>
                        <th>
                            <a asp-action="Index" asp-route-sortOrder="@priceSort" asp-route-searchString="@searchStringP"
                               class="text-white text-decoration-none">
                                Цена
                                @if (currentSort == "price_asc")
                                {
                                    <i class="bi bi-arrow-up"></i>
                                }
                                else if (currentSort == "price_desc")
                                {

                                    <i class="bi bi-arrow-down"></i>
                                }
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index" asp-route-sortOrder="@quantitySort" asp-route-searchString="@searchStringP"
                               class="text-white text-decoration-none">
                                Количество
                                @if (currentSort == "qty_asc")
                                {
                                    <i class="bi bi-arrow-up"></i>
                                }
                                else if (currentSort == "qty_desc")
                                {

                                    <i class="bi bi-arrow-down"></i>
                                }
                            </a>
                        </th>
                        <th class="text-center">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>
                                <span class="badge bg-info text-dark">@item.Category?.Name</span>
                            </td>
                            <td>@item.Price.ToString("N2") ₽</td>
                            <td>
                                @if (item.Quantity == 0)
                                {
                                    <span class="badge bg-danger">Нет в наличии</span>
                                }
                                else
                                {
                                    <span>@item.Quantity</span>
                                }
                            </td>
                            <td class="text-center">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Подробнее">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" title="Редактировать">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Удалить">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center">
            <i class="bi bi-info-circle"></i> Товары не найдены.
            <a asp-action="Create" class="alert-link">Добавьте первый товар!</a>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}