@model ProductCatalog.Model.model.Product.Product
@{
    ViewData["Title"] = "Удаление товара";
}

<div class="container mt-4">
    <h2 class="text-danger"><i class="bi bi-trash"></i> Удаление товара</h2>
    <hr />

    <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle"></i> Вы уверены, что хотите удалить этот товар?
    </div>

    <div class="card" style="max-width: 600px;">
        <div class="card-body">
            <h5 class="card-title">@Model.Name</h5>
            <dl class="row mb-0">
                <dt class="col-sm-4">Категория:</dt>
                <dd class="col-sm-8">@(Model.Category?.Name ?? "—")</dd>

                <dt class="col-sm-4">Издатель:</dt>
                <dd class="col-sm-8">@(Model.Publisher?.Name ?? "—")</dd>

                <dt class="col-sm-4">Цена:</dt>
                <dd class="col-sm-8">@Model.Price.ToString("N2") ₽</dd>

                <dt class="col-sm-4">Количество:</dt>
                <dd class="col-sm-8">@Model.Quantity</dd>

                <dt class="col-sm-4">Описание:</dt>
                <dd class="col-sm-8">@(Model.Description ?? "—")</dd>
            </dl>
        </div>
    </div>

    <form method="post" class="mt-3">
        <input type="hidden" name="id" value="@Model.Id" />
        <button type="submit" class="btn btn-danger">
            <i class="bi bi-trash"></i> Подтвердить удаление
        </button>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Отмена
        </a>
    </form>
</div>