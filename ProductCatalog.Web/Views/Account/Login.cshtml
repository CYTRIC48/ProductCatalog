@model ProductCatalog.Model.model.User.User
@{
    ViewData["Title"] = "Вход в систему";
    Layout = "_LayoutClean";
}

<style>
    .login-wrap {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .login-card {
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.07);
        padding: 40px 36px;
        width: 100%;
        max-width: 420px;
    }

    .login-logo {
        font-size: 26px;
        font-weight: 800;
        background: linear-gradient(90deg, #2097ff, #6b4dff);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: 6px;
    }

    .login-subtitle {
        color: #8b95a8;
        font-size: 14px;
        margin-bottom: 28px;
    }

    .login-card label {
        font-size: 13px;
        font-weight: 600;
        color: #4f5b6b;
        margin-bottom: 6px;
        display: block;
    }

    .login-card .form-control {
        border: 1.5px solid #e9edf5;
        border-radius: 12px;
        padding: 11px 14px;
        font-size: 15px;
        background: #f9fafc;
        transition: border 0.2s;
    }

        .login-card .form-control:focus {
            border-color: #6b4dff;
            background: #fff;
            box-shadow: 0 0 0 3px rgba(107,77,255,0.08);
        }

    .btn-login {
        width: 100%;
        border: none;
        border-radius: 999px;
        padding: 13px;
        font-size: 16px;
        font-weight: 600;
        color: #fff;
        background: linear-gradient(90deg, #2097ff, #6b4dff);
        box-shadow: 0 8px 18px rgba(74,88,255,0.28);
        cursor: pointer;
        transition: opacity 0.2s;
        margin-top: 6px;
    }

        .btn-login:hover {
            opacity: 0.92;
        }

    .login-footer {
        text-align: center;
        margin-top: 20px;
        font-size: 14px;
        color: #8b95a8;
    }

        .login-footer a {
            color: #6b4dff;
            font-weight: 600;
            text-decoration: none;
        }

            .login-footer a:hover {
                text-decoration: underline;
            }
</style>

<div class="login-wrap">
    <div class="login-card">
        <div class="login-logo">МАРКЕТ</div>
        <div class="login-subtitle">Войдите в свой аккаунт</div>

        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small rounded-3"></div>

            <div class="mb-3">
                <label asp-for="Email">Email</label>
                <input asp-for="Email" class="form-control" placeholder="name@example.com" autofocus />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Password">Пароль</label>
                <input asp-for="Password" class="form-control" type="password" placeholder="••••••••" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn-login">Войти</button>
        </form>

        <div class="login-footer">
            Ещё нет аккаунта?
            <a asp-action="Register">Зарегистрироваться</a>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}