@model ProductCatalog.Web.Models.ChangePasswordViewModel
@{
    ViewData["Title"] = "Смена пароля";
    Layout = "_LayoutClean";
}

<style>
    .password-wrap {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 32px 16px;
    }

    .password-card {
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.07);
        padding: 40px 36px;
        width: 100%;
        max-width: 440px;
    }

    .password-logo {
        font-size: 26px;
        font-weight: 800;
        background: linear-gradient(90deg, #2097ff, #6b4dff);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: 6px;
    }

    .password-subtitle {
        color: #8b95a8;
        font-size: 14px;
        margin-bottom: 28px;
    }

    .password-card label {
        font-size: 13px;
        font-weight: 600;
        color: #4f5b6b;
        margin-bottom: 6px;
        display: block;
    }

    .password-card .form-control {
        border: 1.5px solid #e9edf5;
        border-radius: 12px;
        padding: 11px 14px;
        font-size: 15px;
        background: #f9fafc;
        transition: border 0.2s;
    }

        .password-card .form-control:focus {
            border-color: #6b4dff;
            background: #fff;
            box-shadow: 0 0 0 3px rgba(107,77,255,0.08);
        }

    .section-divider {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 20px 0;
        color: #c0c9d8;
        font-size: 12px;
    }

        .section-divider::before,
        .section-divider::after {
            content: '';
            flex: 1;
            height: 1px;
            background: #e9edf5;
        }

    .btn-save {
        width: 100%;
        border: none;
        border-radius: 999px;
        padding: 13px;
        font-size: 16px;
        font-weight: 600;
        color: #fff;
        background: linear-gradient(90deg, #2097ff, #6b4dff);
        box-shadow: 0 8px 18px rgba(74,88,255,0.28);
        cursor: pointer;
        transition: opacity 0.2s;
        margin-top: 6px;
    }

        .btn-save:hover {
            opacity: 0.92;
        }

    .password-footer {
        text-align: center;
        margin-top: 20px;
        font-size: 14px;
    }

        .password-footer a {
            color: #6b4dff;
            font-weight: 600;
            text-decoration: none;
        }

            .password-footer a:hover {
                text-decoration: underline;
            }
</style>

<div class="password-wrap">
    <div class="password-card">
        <div class="password-logo">МАРКЕТ</div>
        <div class="password-subtitle">Смена пароля</div>

        <form asp-action="ChangePassword" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small rounded-3"></div>

            <div class="mb-3">
                <label asp-for="OldPassword">Старый пароль</label>
                <input asp-for="OldPassword" class="form-control" type="password"
                       placeholder="Введите старый пароль" autofocus />
                <span asp-validation-for="OldPassword" class="text-danger small"></span>
            </div>

            <div class="section-divider">новый пароль</div>

            <div class="mb-3">
                <label asp-for="NewPassword">Новый пароль</label>
                <input asp-for="NewPassword" class="form-control" type="password"
                       placeholder="Введите новый пароль" />
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword">Подтверждение пароля</label>
                <input asp-for="ConfirmPassword" class="form-control" type="password"
                       placeholder="Повторите новый пароль" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn-save">Сменить пароль</button>
        </form>

        <div class="password-footer">
            <a asp-action="Profile">← Назад в личный кабинет</a>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}